#!/bin/sh
# This script and root.env are inside the signed boot ramdisk. Never source data-partition files.
set -eu
export PATH=/bin:/sbin
# The initramfs itself is writable before /run exists. Capture entry and mount
# failures before opening any console; no external setup is read here.
exec 2>>/pidock-preflight.log
trap 'rc=$?; if [ "$rc" -ne 0 ]; then pidock-boot-status init_failed "$rc"; fi' EXIT
printf 'stage=init_entry\n' >>/pidock-preflight.log
mount -t devtmpfs devtmpfs /dev
printf 'stage=dev_mounted\n' >>/pidock-preflight.log
mount -t proc proc /proc
printf 'stage=proc_mounted\n' >>/pidock-preflight.log
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
pidock-boot-status init_entry
mount -t sysfs sysfs /sys
printf 'stage=sys_mounted\n' >>/pidock-preflight.log
pidock-boot-status initramfs_started
exec 2>>/run/pidock-init-output.log
pidock-boot-status console_open
exec </dev/console >/dev/console
pidock-boot-status console_ready
# A signed build timestamp is only a plausibility floor, never trusted time.
# Bound the helper and handle failure explicitly: PID 1 must reach verified root
# and networking even when clock bootstrap is unavailable. Never set the RTC here.
pidock-boot-status clock_check
pidock-boot-status clock_set
clock_status=0
/bin/boot-clock "$(cat /etc/build-epoch)" >>/run/pidock-init-output.log 2>&1 || clock_status=$?
if [ "$clock_status" -eq 0 ]; then
    pidock-boot-status clock_ready
else
    printf 'Clock bootstrap failed or timed out (exit %s); continuing with untrusted time.\n' "$clock_status" >>/run/pidock-init-output.log
    pidock-boot-status clock_deferred "$clock_status"
fi
fail() { printf 'PiDockOS startup failure: %s\n' "$*" >>/run/pidock-init-output.log; pidock-boot-status failed; echo "PiDockOS: verified startup failed: $*. Press R during startup for physical recovery." >/dev/console; sleep 3; boot-reboot normal; exit 1; }
# A failed system slot must not make its independent recovery environment unreachable.
echo 'PiDockOS: press R for physical recovery (5 seconds).'
pidock-boot-status recovery_key_wait
key=
read -r -n 1 -t 5 key </dev/tty1 || true
pidock-boot-status recovery_key_done
case "$key" in r|R) pidock-boot-status recovery_selected; exec boot-reboot 1;; esac
pidock-boot-status root_descriptor
. /etc/root.env
# Unauthenticated external command-line arguments cannot select another root or change its hash.
root_device=
pidock-boot-status root_search
for attempt in $(seq 1 60); do
    devices=$(blkid -t "PARTUUID=$ROOT_PARTUUID" -o device || true)
    count=$(echo "$devices" | grep -c '^/dev/' || true)
    [ "$count" -le 1 ] || fail 'ambiguous system media; disconnect duplicate PiDockOS media'
    if [ "$count" -eq 1 ]; then root_device=$devices; break; fi
    case "$attempt" in 10|20|30|40|50|60) pidock-boot-status root_wait;; esac
    sleep 1
done
[ -b "$root_device" ] || fail 'system partition missing'
pidock-boot-status root_found
pidock-boot-status verity_open
veritysetup open "$root_device" pidock-root "$root_device" "$ROOT_HASH" --hash-offset "$HASH_OFFSET" --data-blocks "$((HASH_OFFSET / 4096))" --data-block-size 4096 --hash-block-size 4096 --hash sha256 --restart-on-corruption >>/run/pidock-init-output.log 2>&1 || { pidock-boot-status verity_failed; fail 'root integrity check rejected'; }
pidock-boot-status verity_mapping_ready
mount -t ext4 -o ro /dev/mapper/pidock-root /newroot >>/run/pidock-init-output.log 2>&1 || { pidock-boot-status root_mount_failed; fail 'verified root cannot be mounted'; }
pidock-boot-status root_mounted
pidock-boot-services
pidock-boot-status services_prepared
pidock-boot-status handoff
pidock-boot-status switch_root
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /run /newroot/run
# /var is a dedicated persistent partition mounted by systemd before the application services.
exec switch_root /newroot /sbin/init --unit=multi-user.target
