#!/bin/sh
# All inputs live in the signed initramfs. Never read mutable setup or owner data.
set -eu
export PATH=/bin:/sbin
mkdir -p /run/systemd/system /run/systemd/journald.conf.d
# The diagnostic observer must not delay the appliance UI. Retain ordering before
# the updater so diagnostics cannot remount its boot partition during a trial.
cat /etc/pidock-boot-diagnostics.service >/run/systemd/system/pidock-first-boot-diagnostics.service
# Preserve later startup events across abrupt resets; keep existing journal limits.
printf '[Journal]\nSyncIntervalSec=1s\n' >/run/systemd/journald.conf.d/90-pidock-startup.conf
