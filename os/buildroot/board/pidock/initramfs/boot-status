#!/bin/sh
# Diagnostic observations only. Never read provisioning, owner state or network secrets.
# Export only during early boot, before normal services or recovery authentication.
export PATH=/bin:/sbin
case "${1:-}" in
    initramfs_started|console_open|console_ready|clock_check|clock_set|clock_ready|recovery_key_wait|recovery_key_done|recovery_selected|root_descriptor|root_search|root_wait|root_found|verity_open|verity_failed|verity_mapping_ready|root_mount_failed|root_mounted|handoff|switch_root|recovery_started|recovery_console_open|recovery_console_ready|recovery_confirmation|failed|init_failed) ;;
    *) exit 0 ;;
esac
mkdir -p /run/pidock-boot 2>/dev/null || exit 0
{
    printf 'stage=%s\n' "$1"
    if [ -r /proc/uptime ]; then
        read -r uptime ignored </proc/uptime || true
        printf 'uptime_seconds=%s\n' "$uptime"
    fi
    case "${2:-}" in
        ''|*[!0-9]*) ;;
        *) [ "$2" -le 255 ] 2>/dev/null && printf 'exit_code=%s\n' "$2" ;;
    esac
} >>/run/pidock-early.log 2>/dev/null || true
devices=$(blkid -c /dev/null -t PARTUUID=5049444b-01 -o device 2>/dev/null || true)
count=$(printf '%s\n' "$devices" | grep -c '^/dev/' || true)
[ "$count" = 1 ] || exit 0
# cp437 is built in; early logging must not depend on a loadable charset module.
if mount -t vfat -o rw,nosuid,nodev,noexec,iocharset=cp437,umask=0077 "$devices" /run/pidock-boot 2>/dev/null; then
    # Keep one bounded previous attempt; repeated resets must not erase the last failure.
    case "$1" in initramfs_started|recovery_started)
        if [ -f /run/pidock-boot/pidock-early-boot.log ]; then
            tail -c 65536 /run/pidock-boot/pidock-early-boot.log >/run/pidock-boot/pidock-early-boot.previous.log 2>/dev/null || true
        fi ;;
    esac
    {
        printf '%s\n' 'PiDockOS early boot — diagnostic status, not a security attestation.'
        printf '%s\n' 'Stages use monotonic uptime; wall-clock time may not be synchronized.'
        tail -c 8192 /run/pidock-early.log
        printf '\n--- early startup output (bounded) ---\n'
        [ ! -f /run/pidock-init-output.log ] || tail -c 16384 /run/pidock-init-output.log
        printf '\n--- early kernel messages (bounded; before services) ---\n'
        dmesg 2>/dev/null | tail -c 24576
    } >/run/pidock-boot/pidock-early-boot.log 2>/dev/null || true
    sync
    umount /run/pidock-boot 2>/dev/null || true
fi
exit 0
