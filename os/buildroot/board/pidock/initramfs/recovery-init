#!/bin/sh
# A self-contained signed recovery environment. No systemd, networking or applications start.
set -eu
export PATH=/bin:/sbin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
pidock-boot-status recovery_started
trap 'rc=$?; if [ "$rc" -ne 0 ]; then pidock-boot-status init_failed "$rc"; fi' EXIT
exec 2>>/run/pidock-init-output.log
pidock-boot-status recovery_console_open
exec </dev/tty1 >/dev/tty1
pidock-boot-status recovery_console_ready
pidock-boot-status clock_check
epoch=$(cat /etc/build-epoch)
[ "$(date +%s)" -ge "$epoch" ] || date -u -s "@$epoch" >>/run/pidock-init-output.log 2>&1
pidock-boot-status clock_ready
pidock-boot-status recovery_confirmation
printf '\nPiDockOS physical recovery\nNo network administration is running.\nType RECOVER within 60 seconds to continue: '
trap - EXIT
exec 2>/dev/tty1
answer=
read -r -t 60 answer || { reboot -f; exit 1; }
[ "$answer" = RECOVER ] || { reboot -f; exit 1; }
mkdir -p /run/pidock
printf 'physical-console\n' >/run/pidock/physical-recovery
chown 0:1654 /run/pidock/physical-recovery
chmod 640 /run/pidock/physical-recovery
exec /bin/pidock-recovery
