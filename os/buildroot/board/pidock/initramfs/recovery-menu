#!/bin/sh
set -eu
export PATH=/bin:/sbin
export ASPNETCORE_ENVIRONMENT=Production
export PiDock__StateDirectory=/state/lib/pidock/appliance
export PiDock__RequireTrustedClock=true
# These directories are in RAM, not the verified normal root or external media.
mkdir -p /state /etc/pidock
printf '{"schema":1,"profile":"recovery"}\n' >/etc/pidock/image-profile.json
while true; do
    printf '\n1. Set UTC clock (needed to pair a new authenticator)\n2. Reset appliance owner and authenticator; keep application data\n3. Repair both OS slots using a signed package on a USB drive\n4. Restart normally\nChoice: '
    choice=
    read -r choice || { reboot -f; exit 1; }
    case "$choice" in
      1)
        printf 'Enter current UTC time as YYYY-MM-DD HH:MM:SS: '
        read -r value || continue
        echo "$value" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$' || { echo 'Invalid format.'; continue; }
        date -u -s "$value" || echo 'Clock repair failed.'
        ;;
      2)
        device=$(blkid -t PARTUUID=5049444b-07 -o device || true)
        count=$(echo "$device" | grep -c '^/dev/' || true)
        [ "$count" -eq 1 ] && [ -b "$device" ] || { echo 'Managed data partition missing or ambiguous. No changes made.'; continue; }
        mountpoint -q /state || mount -t ext4 -o nosuid,nodev,noexec "$device" /state || { echo 'Cannot mount managed data. No changes made.'; continue; }
        # Do not follow data-volume links while preparing the credential directory.
        bad=false
        for folder in /state/lib /state/lib/pidock /state/lib/pidock/appliance; do
          if [ -L "$folder" ]; then bad=true; break; fi
          mkdir -p "$folder"
        done
        [ "$bad" = false ] || { echo 'Unsafe data-directory link. No changes made.'; continue; }
        chown 1654:1654 /state/lib/pidock/appliance
        chmod 700 /state/lib/pidock/appliance
        cd /usr/lib/pidock/appliance
        setpriv --reuid=1654 --regid=1654 --clear-groups --bounding-set=-all --inh-caps=-all --ambient-caps=-all ./PiDock.Appliance.Web --recover-owner || echo 'Recovery was not completed.'
        sync
        ;;
      3)
        echo 'Copy the signed whole-system package to the USB drive as PiDockOS-update.zip.'
        printf 'USB transfer partition (for example /dev/sda1): '
        read -r transfer || continue
        echo "$transfer" | grep -Eq '^/dev/sd[a-z]+[0-9]+$' || { echo 'Unsupported transfer device.'; continue; }
        mkdir -p /media/update
        mount -o ro,nosuid,nodev,noexec "$transfer" /media/update || { echo 'Cannot read transfer media.'; continue; }
        cd /usr/lib/pidock/appliance
        ./PiDock.Updater recover-image /media/update/PiDockOS-update.zip || echo 'Image repair is incomplete. Review the error above before restarting.'
        umount /media/update
        ;;
      4) sync; boot-reboot normal; exit 0;;
      *) echo 'Choose 1, 2, 3 or 4.';;
    esac
 done
