[Unit]
Description=PiDock persistent interface configuration
Requires=pidock-provision.service pidock-usb-gadget.service
After=pidock-provision.service pidock-usb-gadget.service
Before=systemd-networkd.service pidock-wifi.service
[Service]
Type=oneshot
ExecStart=/usr/lib/pidock/appliance/PiDock.Appliance.Web --apply-media-network
Environment=PiDock__StateDirectory=/var/lib/pidock/appliance
Environment=ASPNETCORE_ENVIRONMENT=Production
UMask=0077
RemainAfterExit=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/systemd/network /var/lib/pidock/appliance
RuntimeDirectory=systemd/network
RuntimeDirectoryMode=0755
[Install]
WantedBy=multi-user.target
