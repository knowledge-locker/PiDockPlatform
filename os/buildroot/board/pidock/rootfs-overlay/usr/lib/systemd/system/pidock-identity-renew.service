[Unit]
Description=Renew PiDock local HTTPS certificate before expiry
After=pidock-identity.service
Requires=pidock-identity.service
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/lib/pidock/create-local-identity.sh
TimeoutStartSec=infinity
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pidock/identity
