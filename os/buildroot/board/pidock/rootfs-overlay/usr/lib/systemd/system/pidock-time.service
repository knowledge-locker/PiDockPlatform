[Unit]
Description=PiDock authenticated time evidence
After=chrony.service
Requires=chrony.service
[Service]
User=root
ExecStart=/usr/lib/pidock/updater/PiDock.Updater host-time-guard
RuntimeDirectory=pidock-time
RuntimeDirectoryMode=0755
UMask=0022
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectClock=true
CapabilityBoundingSet=
ReadWritePaths=/run/pidock-time
[Install]
WantedBy=multi-user.target
