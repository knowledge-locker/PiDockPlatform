@page "/os-updates"
@attribute [Authorize(Roles = "Owner,Administrator")]
@inject OsUpdateStore Store
@inject AuthenticationStateProvider Authentication
@inject UserStore Users
<PageTitle>PiDockOS releases · PiDockCloud</PageTitle>
<p class="eyebrow">PIDOCKCLOUD / SOFTWARE</p><h1>PiDockOS releases</h1>
<p>Publish a signed PiDockOS service package for your organization. Approve installation on an individual device from its dashboard.</p>
<section class="card"><h2>Publish a release</h2><p>The cloud verifies the package against its configured release-signing public keys. Each appliance independently verifies it against its own trusted keys. Release versions are immutable for each runtime.</p>
<InputFile OnChange="e => file = e.File" accept=".zip" disabled="@busy" />
@if (file is not null) { <p>@file.Name · @Format.Bytes(file.Size)</p> }
<label>Cloud password<input type="password" @bind="password" autocomplete="current-password" maxlength="256" /></label>
<label>Fresh authenticator code<input @bind="otp" autocomplete="one-time-code" inputmode="numeric" maxlength="6" /></label>
<button disabled="@(busy || file is null)" @onclick="Publish">@(busy ? "Verifying release…" : "Publish signed release")</button><p role="status">@message</p></section>
<section class="card"><h2>Organization releases</h2>
@if (releases.Length == 0) { <p>No PiDockOS releases published yet.</p> }
else { <div class="table-scroll"><table><thead><tr><th>Version</th><th>Runtime</th><th>Signer</th><th>Published</th><th>SHA-256</th></tr></thead><tbody>@foreach (var entry in releases) { <tr><td>@entry.Release.Version</td><td>@entry.Release.Runtime</td><td>@entry.Release.KeyId</td><td>@entry.PublishedAt.UtcDateTime.ToString("u")<br/><small>@entry.PublishedBy</small></td><td><small style="overflow-wrap:anywhere">@entry.Release.Digest</small></td></tr> }</tbody></table></div> }
</section>
@code {
    private IBrowserFile? file; private bool busy; private string password = "", otp = "", message = ""; private PublishedOsRelease[] releases = [];
    protected override async Task OnInitializedAsync() => releases = Store.Releases((await Authentication.GetAuthenticationStateAsync()).User);
    private async Task Publish()
    {
        if (busy || file is null) return; busy = true;
        try {
            var user = (await Authentication.GetAuthenticationStateAsync()).User;
            if (!Users.IsCurrent(user) || !EnrollmentStore.CanManage(user) || Users.Authenticate(user.Identity!.Name!, password, otp, DateTimeOffset.UtcNow) is null) { message = "Your cloud owner/administrator password and a fresh authenticator code are required."; return; }
            await using var input = file.OpenReadStream(OsUpdateRules.MaximumPackageBytes);
            var release = await Store.Publish(user, input); releases = Store.Releases(user); file = null; message = $"Version {release.Release.Version} verified and published. Select a device to approve installation.";
        }
        catch (Exception e) when (e is IOException or InvalidDataException or InvalidOperationException or UnauthorizedAccessException or System.Security.Cryptography.CryptographicException or System.Text.Json.JsonException or OperationCanceledException) { message = "Release rejected. Check package signature, trusted signer, runtime, size, immutable version and storage quota."; }
        finally { password = ""; otp = ""; busy = false; }
    }
}
