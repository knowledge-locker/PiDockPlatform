@inject UserStore Users
@inherits LayoutComponentBase
<a class="skip-link" href="#main-content">Skip to content</a><div class="shell"><aside class="sidebar"><a href="/" class="brand">◈ PiDockCloud <span>PiDockPlatform</span></a><p class="eyebrow">WORKSPACE</p><nav aria-label="Main navigation"><NavLink href="/" Match="NavLinkMatch.All">◫ Fleet overview</NavLink><a href="/workspaces">♙ Workspaces &amp; team</a><NavLink href="/os-updates">↓ PiDockOS releases</NavLink><NavLink href="/provisioning">▣ Create SD image</NavLink><NavLink href="/enrollment">＋ Add device</NavLink></nav><div class="sidebar-bottom"><span class="pill">Engineering preview · v0.1</span><small>Secure defaults. Visible boundaries.</small></div></aside><div class="workspace"><header><span>Self-hostable fleet platform</span><div><AuthorizeView><Authorized Context="auth"><span>@auth.User.Identity?.Name</span>
@if (Users.CloudAccounts && Users.IsCurrent(auth.User)) {
<form action="/workspaces/switch" method="post" class="workspace-select"><AntiforgeryToken/><label class="sr-only" for="workspace-selector">Workspace</label><select id="workspace-selector" name="workspace">
@if(auth.User.IsInRole("Owner")) { <option value="" selected="@(auth.User.FindFirst("tenant")?.Value == "")">Platform administration</option> }
@foreach (var workspace in Users.WorkspacesFor(auth.User)) { <option value="@workspace.Id" selected="@(auth.User.FindFirst("tenant")?.Value == workspace.Id)">@workspace.Name · @workspace.Role</option> }
</select><button class="secondary">Switch</button></form>
}</Authorized></AuthorizeView><form action="/auth/logout" method="post"><AntiforgeryToken/><button class="text-button">Sign out</button></form></div></header><main id="main-content" tabindex="-1"><AuthorizeView><Authorized Context="context">@if(context.User.IsInRole("Owner") && !string.IsNullOrEmpty(context.User.FindFirst("tenant")?.Value)) { <p class="notice">Owner support access · Workspace @WorkspaceLabel(context.User) · <a href="/workspaces">Change workspace</a></p> }</Authorized></AuthorizeView>@Body</main><footer>PiDockPlatform · Hardware-aware. Cloud-optional.</footer></div></div><div id="blazor-error-ui">Connection interrupted. <a href="">Reload</a></div>
@code {
    private string WorkspaceLabel(System.Security.Claims.ClaimsPrincipal user) => Users.CloudAccounts && Users.IsCurrent(user)
        ? Users.WorkspacesFor(user).FirstOrDefault(w => w.Id == user.FindFirst("tenant")?.Value)?.Name ?? "Unavailable"
        : user.FindFirst("tenant")?.Value ?? "";
}
