@page "/gpio"
@implements IAsyncDisposable
@inject GpioSimulator Pins
@inject HistoryStore History
@inject AuthenticationStateProvider Authentication
@inject UserStore Users
<PageTitle>Live I/O · PiDockOS</PageTitle>
<div class="page-heading"><div><p class="eyebrow">APPLIANCE / LIVE I/O</p><h1>GPIO and interfaces</h1><p>40-pin header map, logical states, and timed maintenance controls.</p></div><span class="pill">@(Pins.Enabled ? "SIMULATION · no hardware writes" : "Physical driver not connected")</span></div>
<div class="notice">@(Pins.Enabled ? "All values and overrides on this page are simulated. Overrides expire after 60 seconds and release when you leave this page." : "Physical states are unknown. To explore controls locally, enable PiDock:SimulateGpio in Development. No physical GPIO access is performed.")</div>
<div class="columns gpio-layout"><section class="card"><h2>40-pin header</h2><div class="pin-header"><span>Label</span><span>Physical pins</span><span>Label</span></div><div class="pinout">@foreach (var pin in Pins.Read()) { <button class="pin @(pin.Gpio.HasValue ? "signal" : "fixed") @(pin.Forced ? "forced" : "") @(selected?.Physical == pin.Physical ? "selected" : "")" aria-pressed="@(selected?.Physical == pin.Physical)" aria-label="@($"Pin {pin.Physical}: {pin.Label}")" @onclick="() => Select(pin)"><span>@pin.Label</span><b>@pin.Physical</b><small>@(pin.High.HasValue ? pin.High.Value ? "HIGH" : "LOW" : "—")</small></button> }</div></section>
<section class="card pin-inspector" tabindex="-1" @ref="inspector"><h2>Pin inspector</h2>@if (selected is { } chosen) { var live = Pins.Read().Single(p => p.Physical == chosen.Physical); <dl><dt>Physical pin</dt><dd>@live.Physical</dd><dt>Signal</dt><dd>@live.Label</dd><dt>State</dt><dd>@(live.High.HasValue ? live.High.Value ? "HIGH · simulated" : "LOW · simulated" : "Unknown / fixed supply")</dd><dt>Override</dt><dd>@(live.Forced ? $"{live.RemainingSeconds}s remaining" : "None")</dd></dl>@if (live.Gpio is { } gpio && !GpioSimulator.IsAssignable(gpio)) { <p class="notice">Reserved bus pin. Manual output control is unavailable.</p> }<div class="actions"><button disabled="@(!Pins.CanForce(live.Gpio))" @onclick="() => Force(live.Gpio, true)">Force HIGH</button><button disabled="@(!Pins.CanForce(live.Gpio))" @onclick="() => Force(live.Gpio, false)">Force LOW</button><button class="secondary" disabled="@(!Pins.Read().Any(p => p.Forced))" @onclick="Release">Release overrides</button></div> } else { <p>Select a pin to inspect it.</p> }<p role="status">@message</p><small>Bus pins are reserved. Production handoff, hardware fallback, PWM and simulated application inputs are not implemented in this preview.</small></section></div>
@code {
    private ElementReference inspector;
    private async Task Select(PinState pin) { selected = pin; await inspector.FocusAsync(); }
    private PinState? selected; private string? message; private readonly CancellationTokenSource stop = new(); private Task? refresh;
    protected override void OnInitialized() => refresh = Refresh();
    private async Task Force(int? gpio, bool high)
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        if (!Users.IsCurrent(user) || !user.IsInRole("Owner")) { message = "Owner sign-in required."; return; }
        try { if (gpio is null) return; Pins.Force(gpio.Value, high); History.Append(HistoryClass.Audit, new { action = "simulation.override", gpio, high, at = DateTimeOffset.UtcNow }); message = "Simulated override active for 60 seconds."; }
        catch (ArgumentException e) { message = e.Message; }
    }
    private void Release() { Pins.ReleaseAll(); message = "Simulation overrides released."; }
    private async Task Refresh() { try { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1)); while (await timer.WaitForNextTickAsync(stop.Token)) await InvokeAsync(StateHasChanged); } catch (OperationCanceledException) { } }
    public async ValueTask DisposeAsync() { Pins.ReleaseAll(); await stop.CancelAsync(); if (refresh is not null) await refresh; stop.Dispose(); }
}
