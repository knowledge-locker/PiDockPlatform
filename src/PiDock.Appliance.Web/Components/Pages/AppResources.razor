@page "/app-resources"
@attribute [Authorize(Roles = "Owner")]
@inject ApplicationCredentialVault Vault
<PageTitle>App credentials · PiDockOS</PageTitle>
<p class="eyebrow">APPLIANCE / APPLICATIONS</p><h1>App credentials</h1>
<p>Create credentials for managed app delivery. Secret values stay on the server and are delivered as private files when an app starts through PiDockOS.</p>
<section class="card"><h2>Assigned credentials</h2>
<table><thead><tr><th>App / credential</th><th>Purpose</th><th>Version</th><th>Expires</th><th>State</th><th>Control</th></tr></thead><tbody>
@foreach (var entry in entries) { <tr><td>@entry.AppId / @entry.Id</td><td>@entry.Purpose</td><td>@entry.Version</td><td>@entry.ExpiresAt.ToLocalTime().ToString("g")</td><td>@(entry.Revoked ? "Revoked" : entry.ExpiresAt <= DateTimeOffset.UtcNow ? "Expired" : "Active")</td><td><button class="secondary" disabled="@(busy || entry.Revoked)" @onclick="() => Revoke(entry)">Revoke</button></td></tr> }
</tbody></table></section>
<section class="card"><h2>Create or rotate</h2>
<label>App ID<input id="credential-app-id" @bind="appId" @bind:event="oninput" maxlength="40" disabled="@busy" /></label>
<label>Credential name<input id="credential-name" @bind="credentialId" @bind:event="oninput" maxlength="40" disabled="@busy" /></label>
<label>Purpose<select id="credential-purpose" @bind="purpose" disabled="@busy"><option value="ui-bridge">Authenticated app interface</option><option value="platform">Shared platform services</option></select></label>
<label>Expires in days<input id="credential-days" type="number" min="1" max="90" @bind="days" @bind:event="oninput" disabled="@busy" /></label>
@if (purpose == "platform") { <label>Allowed scopes, separated by commas<input id="credential-scopes" @bind="scopes" @bind:event="oninput" disabled="@busy" /></label><small>system.read, logs.read, logs.write, telemetry.read, telemetry.write, alarms.read, alarms.raise, alarms.acknowledge, io.read, io.write, io.simulate, signals.runtime, signals.engineer, notifications.read, notifications.acknowledge. I/O and engineering require separate target enablement and grants. Reads are limited to the app's own records.</small> }
<button disabled="@busy" @onclick="Issue">Create or rotate credential</button>
<p>Use the app ID and credential name in the deployment form. For an app interface, use the same name in its bridge registration.</p>
<p>Each change opens an Owner confirmation dialog. Rotation and revocation take effect immediately in PiDockOS. Restart the app through PiDockOS to deliver a replacement file.</p>
</section>
<p role="status">@message</p>
<ReauthenticationDialog @ref="confirmation" />
@code {
    private ReauthenticationDialog confirmation = default!;
    private ApplicationCredentialInfo[] entries = [];
    private string appId = "", credentialId = "", purpose = "ui-bridge", scopes = "logs.write,telemetry.write";
    private int days = 30;
    private bool busy;
    private string? message;
    protected override void OnInitialized() => entries = Vault.Read();
    private async Task Issue()
    {
        if (busy) return;
        message = "";
        // Freeze the reviewed settings before the dialog. Only the vault consumes MFA.
        var app = appId.Trim(); var id = credentialId.Trim(); var requestedPurpose = purpose;
        var requestedScopes = requestedPurpose == "platform" ? scopes.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) : [];
        try {
            if (days is < 1 or > 90) throw new ArgumentException("Choose an expiry from 1 to 90 days.");
            var expires = DateTimeOffset.UtcNow.AddDays(days);
            Vault.ValidateIssue(app, id, requestedPurpose, expires, requestedScopes);
            var title = entries.Any(e => e.AppId == app && e.Id == id) ? "Rotate app credential" : "Create app credential";
            var detail = $"{app} / {id} · {(requestedPurpose == "ui-bridge" ? "Authenticated app interface" : "Shared platform services")} · expires {expires:u}. Scopes: {(requestedScopes.Length == 0 ? "none" : string.Join(", ", requestedScopes))}.";
            await Change(title, detail, (user, password, code) => Vault.Issue(user, password, code, app, id, requestedPurpose, expires, requestedScopes), resetForm: true);
        }
        catch (Exception e) when (e is ArgumentException or InvalidOperationException) { message = e.Message; }
    }
    private Task Revoke(ApplicationCredentialInfo entry) => Change("Revoke app credential", $"Revoke {entry.AppId} / {entry.Id}. Existing authority is withdrawn immediately; delivered files are refreshed only by a managed restart.", (user, password, code) => Vault.Revoke(user, password, code, entry.AppId, entry.Id));
    private async Task Change(string title, string detail, Action<System.Security.Claims.ClaimsPrincipal, string, string> action, bool resetForm = false)
    {
        if (busy) return;
        busy = true; message = ""; bool applied = false;
        try {
            await confirmation.Request(title, detail, (user, password, code) => { action(user, password, code); applied = true; return true; });
            // A browser-close failure cannot undo a completed server action or justify a retry.
            if (applied) { entries = Vault.Read(); if (resetForm) { appId = ""; credentialId = ""; purpose = "ui-bridge"; scopes = "logs.write,telemetry.write"; days = 30; } message = "Credential updated. Restart the app through PiDockOS to refresh its credential files."; }
        }
        finally { busy = false; }
    }
}
