ASPNETCORE_URLS=http://+:8080
ASPNETCORE_ENVIRONMENT=Production
PiDock__StateDirectory=/var/lib/pidock
AllowedHosts=pidock.knowledgelocker.ai
ReverseProxy__Enabled=true
ReverseProxy__KnownProxies__0=CONFIGURE_TRUSTED_PROXY_IP
Mqtt__Enabled=false
# Enable MQTT after its private network and worker credentials are configured.
Mqtt__Host=broker
Mqtt__CertificatePath=/certs/worker.crt
Mqtt__PrivateKeyPath=/certs/worker.key
Mqtt__CaPath=/certs/ca.crt
Enrollment__IssuerCertificatePath=/enrollment/issuer.crt
Enrollment__IssuerKeyPath=/enrollment/issuer.key
Enrollment__BrokerCaPath=/certs/ca.crt
Enrollment__MqttHost=pidock.knowledgelocker.ai
Enrollment__MqttPort=8883

# Enable only when production remote HTTPS routing and local opt-in are ready.
# RemoteAccess__CloudOrigin=https://pidock.knowledgelocker.ai
# RemoteAccess__Domain=pidock-access.knowledgelocker.ai
# Include *.pidock-access.knowledgelocker.ai in AllowedHosts when enabling.
