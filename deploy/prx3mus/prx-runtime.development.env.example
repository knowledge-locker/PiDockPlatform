ASPNETCORE_URLS=http://+:8080
ASPNETCORE_ENVIRONMENT=Production
PiDock__StateDirectory=/var/lib/pidock
AllowedHosts=pidock-dev.knowledgelocker.ai
ReverseProxy__Enabled=true
ReverseProxy__KnownProxies__0=172.18.0.2
Mqtt__Enabled=true
# Development host only: revalidate the exact proxy address after Caddy/network replacement.
Mqtt__Host=pidock-development-broker
Mqtt__CertificatePath=/certs/worker.crt
Mqtt__PrivateKeyPath=/certs/worker.key
Mqtt__CaPath=/certs/ca.crt
Enrollment__IssuerCertificatePath=/enrollment/issuer.crt
Enrollment__IssuerKeyPath=/enrollment/issuer.key
Enrollment__BrokerCaPath=/certs/ca.crt
Enrollment__MqttHost=pidock-dev.knowledgelocker.ai
Enrollment__MqttPort=8883

# Public release-signing anchor is mounted by the development runtime profile.
Updates__TrustDirectory=/certs
